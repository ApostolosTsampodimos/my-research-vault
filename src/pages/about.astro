---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="About — Apostolos Tsampodimos" description="About Apostolos Tsampodimos and this research vault">
  <main data-page="detail">
    <div data-component="container">
      <div data-component="content">
        <div data-component="detail-nav">
          <a href={`${base}/`} data-slot="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            All materials
          </a>
        </div>

        <section data-component="detail-hero">
          <h1>About</h1>
        </section>

        <section data-component="detail-section">
          <p data-slot="detail-abstract">
            Hi, I'm Apostolos, and this vault collects my papers, talks, posters and animations in one place, with slides, source code and notes for each.
          </p>
        </section>

        <section data-component="detail-content">
          <h2>Research</h2>
          <p>
            I am currently interested in the implicit assumptions an observer makes when doing
            physics, and in how this bias shapes their analysis – that is, our own. I seek to
            understand which quantities are entirely independent of the observer, and together
            with my supervisor I have begun by tackling the concept of scale. This overlaps with
            conformal transformations, but the idea I am pursuing is that, as observers, we are
            free to choose our reference length, with respect to which we take all of our
            measurements. In my research I make use of Hamiltonian constraint analysis and
            symplectic geometry, among other tools, and I hope soon to generalise these ideas
            beyond scale.
          </p>

          <h2>Contact</h2>
          <div data-slot="contact-links">
            <a href="https://github.com/ApostolosTsampodimos" target="_blank" rel="noopener" data-slot="contact-icon" aria-label="GitHub" title="GitHub">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a href="mailto:apostolos.tsampodimos@ftmc.lt" data-slot="contact-icon" data-icon="mail" aria-label="Email apostolos.tsampodimos@ftmc.lt" title="apostolos.tsampodimos@ftmc.lt">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <path data-part="flap" d="M2.6 6.2 12 13l9.4-6.8" />
              </svg>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const materials = await getCollection('materials', ({ data }) => !data.draft);
  return materials.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---
<Base title={`${item.data.title} — Apostolos Tsampodimos`} description={item.data.abstract}>
  <div class="lander">

    <section class="detail-nav">
      <a href={base}>← Back</a>
    </section>

    <section class="detail-hero">
      <div class="detail-meta-row">
        <span class="type-badge" data-type={item.data.type}>{item.data.type}</span>
        <span class="detail-date">{formatDate(item.data.date)}</span>
      </div>
      <h1>{item.data.title}</h1>
      {item.data.venue && (
        <p class="detail-venue">{item.data.venue}</p>
      )}
    </section>

    {item.data.abstract && (
      <section class="detail-section">
        <p class="detail-abstract">{item.data.abstract}</p>
      </section>
    )}

    {item.data.tags.length > 0 && (
      <section class="detail-section detail-tags">
        {item.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </section>
    )}

    {(item.data.slides || item.data.pdf) && (
      <section class="detail-actions">
        {item.data.slides && (
          <a href={`${base}${item.data.slides.replace(/^\//, '')}`} class="action-btn" target="_blank" rel="noopener">
            Open slides
          </a>
        )}
        {item.data.pdf && (
          <a href={`${base}${item.data.pdf.replace(/^\//, '')}`} class="action-btn" download>
            Download PDF
          </a>
        )}
      </section>
    )}

    {item.data.video && (
      <section class="detail-section">
        <video
          class="detail-video"
          src={`${base}${item.data.video.replace(/^\//, '')}`}
          controls
          preload="metadata"
        />
      </section>
    )}

    {item.data.slides && (
      <section class="detail-section">
        <iframe
          class="detail-slides"
          src={`${base}${item.data.slides.replace(/^\//, '')}`}
          title={`Slides: ${item.data.title}`}
          loading="lazy"
        />
      </section>
    )}

    <section class="detail-content">
      <Content />
    </section>

    <section class="footer">
      <div class="footer-col">
        <span>Apostolos Tsampodimos</span>
      </div>
    </section>

  </div>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TypeBadge from '../components/TypeBadge.astro';

export async function getStaticPaths() {
  const materials = await getCollection('materials', ({ data }) => !data.draft);
  return materials.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function formatDate(date: Date) {
  return date.toLocaleDateString('en', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---
<Base title={`${item.data.title} — Apostolos Tsampodimos`} description={item.data.abstract}>
  <main data-page="detail">
    <div data-component="container">
      <div data-component="content">
        <div data-component="detail-nav">
          <a href={`${base}/`}>&larr; Back</a>
        </div>

        <section data-component="detail-hero">
          <div data-slot="detail-meta-row">
            <TypeBadge type={item.data.type} />
            <span data-slot="detail-date">{formatDate(item.data.date)}</span>
          </div>
          <h1>{item.data.title}</h1>
          {item.data.authors.length > 0 && (
            <p data-slot="detail-venue">{item.data.authors.join(', ')}</p>
          )}
          {item.data.venue && (
            <p data-slot="detail-venue">{item.data.venue}</p>
          )}
        </section>

        {item.data.abstract && (
          <section data-component="detail-section">
            <p data-slot="detail-abstract">{item.data.abstract}</p>
          </section>
        )}

        {item.data.tags.length > 0 && (
          <section data-component="detail-section">
            <div data-component="detail-tags">
              {item.data.tags.map(tag => <span data-slot="tag">{tag}</span>)}
            </div>
          </section>
        )}

        {(item.data.slides || item.data.pdf || item.data.arxiv || item.data.doi) && (
          <section data-component="detail-actions">
            {item.data.slides && (
              <a
                href={`${base}/${item.data.slides.replace(/^\//, '')}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                Open slides
              </a>
            )}
            {item.data.pdf && (
              <a
                href={`${base}/${item.data.pdf.replace(/^\//, '')}`}
                data-slot="action-btn"
                download
              >
                Download PDF
              </a>
            )}
            {item.data.arxiv && (
              <a
                href={`https://arxiv.org/abs/${item.data.arxiv}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                arXiv:{item.data.arxiv}
              </a>
            )}
            {item.data.doi && (
              <a
                href={`https://doi.org/${item.data.doi}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                Journal (DOI)
              </a>
            )}
          </section>
        )}

        {item.data.video && (
          <section data-component="detail-video">
            <video
              src={`${base}/${item.data.video.replace(/^\//, '')}`}
              controls
              preload="metadata"
            />
          </section>
        )}

        {item.data.slides && (
          <section data-component="detail-slides">
            <iframe
              src={`${base}/${item.data.slides.replace(/^\//, '')}`}
              title={`Slides: ${item.data.title}`}
              loading="lazy"
            />
          </section>
        )}

        <section data-component="detail-content">
          <Content />
        </section>

      </div>
    </div>

  </main>
</Base>

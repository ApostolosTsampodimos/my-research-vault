---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TypeBadge from '../components/TypeBadge.astro';
import { renderMath, stripMath } from '../lib/math';

export async function getStaticPaths() {
  const materials = await getCollection('materials', ({ data }) => !data.draft);
  return materials.map(item => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
// The Markdown body fills the notes section, shown on every page; HTML comments alone don't count
const hasNotes = (item.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${base}/${path.replace(/^\//, '')}`;

// Talks with an expanded cut get a slides viewer that switches between the two PDFs;
// posters get the same viewer with the poster as the cover and a single download
const isPoster = item.data.type === 'poster';
const formats = item.data.pdf && item.data.pdfExpanded ? [
  {
    key: 'presented',
    label: 'Normal',
    href: asset(item.data.pdf),
  },
  {
    key: 'expanded',
    label: 'Expanded',
    href: asset(item.data.pdfExpanded),
  },
] : isPoster && item.data.pdf ? [
  {
    key: 'poster',
    label: 'Full size',
    href: asset(item.data.pdf),
  },
] : [];

// Papers get a Cite button that copies a BibTeX entry; a `bibtex` field in the frontmatter overrides it
function buildBibtex() {
  const { title, authors, date, venue, doi, arxiv } = item.data;
  const year = date.getFullYear();
  const ascii = (s: string) => s.normalize('NFD').replace(/[^A-Za-z]/g, '');
  const surname = (name: string) => name.trim().split(/\s+/).pop() ?? '';
  const stopwords = new Set(['a', 'an', 'the', 'on', 'of', 'in', 'for', 'and', 'to']);
  const keyword = title.split(/\s+/).map(ascii).find(w => w && !stopwords.has(w.toLowerCase())) ?? '';
  const key = `${ascii(surname(authors[0] ?? 'Tsampodimos'))}${year}${keyword.toLowerCase()}`;
  // "Phys. Rev. D 113, 035007 (2026)" → "Phys. Rev. D"; preprints have no journal
  const journal = venue && venue !== 'Preprint' ? venue.match(/^(.*?)\s+\d/)?.[1] ?? venue : undefined;

  const fields: [string, string | number | undefined][] = [
    ['author', authors.map(a => {
      const last = surname(a);
      const first = a.trim().slice(0, -last.length).trim();
      return first ? `${last}, ${first}` : last;
    }).join(' and ')],
    ['title', `{${title}}`],
    ['journal', journal],
    ['year', year],
    ['doi', doi],
    ['eprint', arxiv],
    ['archivePrefix', arxiv && 'arXiv'],
  ];
  const body = fields
    .filter(([, v]) => v !== undefined && v !== '')
    .map(([k, v]) => `  ${k} = {${v}}`)
    .join(',\n');
  return `@${journal ? 'article' : 'misc'}{${key},\n${body}\n}`;
}

const bibtex = item.data.type === 'paper' ? (item.data.bibtex?.trim() ?? buildBibtex()) : undefined;

function formatDate(date: Date) {
  return date.toLocaleDateString('en', {
    year: 'numeric', month: 'long', day: 'numeric',
  });
}
---
<Base title={`${item.data.title} — Apostolos Tsampodimos`} description={item.data.abstract && stripMath(item.data.abstract)}>
  <main data-page="detail">
    <div data-component="container">
      <div data-component="content">
        <div data-component="detail-nav">
          <a href={`${base}/`} data-slot="back-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            All materials
          </a>
        </div>

        <section data-component="detail-hero">
          <div data-slot="detail-meta-row">
            <TypeBadge type={item.data.type} />
            <span data-slot="detail-date">{formatDate(item.data.date)}</span>
          </div>
          <h1>{item.data.title}</h1>
          {item.data.authors.length > 0 && (
            <p data-slot="detail-venue">{item.data.authors.join(', ')}</p>
          )}
          {item.data.venue && (
            <p data-slot="detail-venue">{item.data.venue}</p>
          )}
        </section>

        {item.data.abstract && (
          <section data-component="detail-section">
            <h2 data-slot="section-label">{item.data.type === 'animation' ? 'Description' : 'Abstract'}</h2>
            <p data-slot="detail-abstract" set:html={renderMath(item.data.abstract)} />
          </section>
        )}

        {formats.length > 0 && (
          <section data-component="detail-formats">
            <h2 data-slot="section-label">{isPoster ? 'Poster' : 'Slides'}</h2>
            <div data-slot="format-layout" data-poster={isPoster || undefined}>
              {item.data.thumbnail && (
                <img
                  src={asset(item.data.thumbnail)}
                  alt={isPoster ? `Poster: ${item.data.title}` : `Title slide: ${item.data.title}`}
                  data-slot="format-cover"
                  loading="lazy"
                />
              )}
              <div data-slot="format-options">
                {formats.map(f => (
                  <a href={f.href} data-slot="format-option" download>
                    <span data-slot="format-tag">{f.label}</span>
                    <span data-slot="format-cta">Download PDF</span>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}

        {(item.data.slides || (item.data.pdf && formats.length === 0) || item.data.arxiv || item.data.doi || bibtex) && (
          <section data-component="detail-actions">
            {item.data.slides && (
              <a
                href={`${base}/${item.data.slides.replace(/^\//, '')}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                Open slides
              </a>
            )}
            {item.data.pdf && formats.length === 0 && (
              <a
                href={`${base}/${item.data.pdf.replace(/^\//, '')}`}
                data-slot="action-btn"
                download
              >
                Download PDF
              </a>
            )}
            {item.data.arxiv && (
              <a
                href={`https://arxiv.org/abs/${item.data.arxiv}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                arXiv:{item.data.arxiv}
              </a>
            )}
            {item.data.doi && (
              <a
                href={`https://doi.org/${item.data.doi}`}
                data-slot="action-btn"
                target="_blank"
                rel="noopener"
              >
                Journal (DOI)
              </a>
            )}
            {bibtex && (
              <button type="button" data-slot="action-btn" data-cite={bibtex} title="Copy BibTeX to clipboard">
                Cite
              </button>
            )}
          </section>
        )}

        {item.data.video && (
          <section data-component="detail-video">
            <video
              src={`${base}/${item.data.video.replace(/^\//, '')}`}
              controls
              preload="metadata"
            />
          </section>
        )}

        {item.data.slides && (
          <section data-component="detail-slides">
            <iframe
              src={`${base}/${item.data.slides.replace(/^\//, '')}`}
              title={`Slides: ${item.data.title}`}
              loading="lazy"
            />
          </section>
        )}

        <section data-component="detail-content" data-empty={hasNotes ? undefined : ''}>
          <h2 data-slot="section-label">Notes &amp; comments</h2>
          <Content />
        </section>

      </div>
    </div>

  </main>
</Base>

<script>
  const cite = document.querySelector<HTMLButtonElement>('[data-cite]');
  cite?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(cite.dataset.cite!);
      cite.textContent = 'BibTeX copied';
    } catch {
      cite.textContent = 'Copy failed';
    }
    setTimeout(() => { cite.textContent = 'Cite'; }, 2000);
  });
</script>


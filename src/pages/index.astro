---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TypeBadge from '../components/TypeBadge.astro';

const allMaterials = await getCollection('materials', ({ data }) => !data.draft);
allMaterials.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const types = ['all', 'paper', 'talk', 'poster', 'animation'] as const;

const counts = {
  paper: allMaterials.filter(m => m.data.type === 'paper').length,
  talk: allMaterials.filter(m => m.data.type === 'talk').length,
  poster: allMaterials.filter(m => m.data.type === 'poster').length,
  animation: allMaterials.filter(m => m.data.type === 'animation').length,
};

// Stand-in artwork for items without a thumbnail
const thumbIcons: Record<string, string> = {
  paper: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4M9 12h7M9 15h7M9 18h4"/>',
  talk: '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M12 16v4M8 20h8"/>',
  poster: '<rect x="5" y="3" width="14" height="18" rx="1"/><path d="M8 7h8M8 11h8M8 15h5"/>',
  animation: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l5.5 3.5-5.5 3.5z"/>',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<Base title="My Research Vault — Apostolos Tsampodimos">
  <main data-page="archive">
    <div data-component="container">
      <div data-component="content">
        <section data-component="hero">
          <div data-slot="hero-actions">
            <a href={`${base}/about/`} data-slot="neon-btn">About</a>
            <a href="https://github.com/ApostolosTsampodimos" target="_blank" rel="noopener" data-slot="hero-github" aria-label="GitHub">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
          </div>
          <div data-slot="hero-copy">
            <h1>My Research Vault</h1>
          </div>
          <ul data-slot="hero-list">
            <li>
              <span>─</span>
              <div>
                <strong>Papers</strong> Research articles and preprints, with PDFs and links to arXiv and the journal.
              </div>
            </li>
            <li>
              <span>─</span>
              <div>
                <strong>Talks</strong> Conference and seminar presentations with slides and extended notes.
              </div>
            </li>
            <li>
              <span>─</span>
              <div>
                <strong>Posters</strong> Research posters presented at workshops and conferences.
              </div>
            </li>
            <li>
              <span>─</span>
              <div>
                <strong>Animations</strong> Physics visualizations created with Manim, including the source code and materials.
              </div>
            </li>
          </ul>
        </section>

        <section data-component="filters" id="filter-bar">
          {types.map(t => {
            const count = t === 'all' ? allMaterials.length : counts[t];
            return (
              <button
                class:list={[{ active: t === 'all' }]}
                data-slot="filter-btn"
                data-type={t}
              >
                <span data-slot="filter-plate" aria-hidden="true"></span>
                <span data-slot="filter-label">{t === 'all' ? 'All' : `${t}s`} <span data-slot="filter-count">{count}</span></span>
              </button>
            );
          })}
          <label data-slot="search">
            <span class="visually-hidden">Search materials</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
            <input id="search" type="search" placeholder="Search titles, authors, venues, tags…" autocomplete="off" />
          </label>
        </section>

        <div data-component="materials" id="materials-grid">
          {allMaterials.length === 0 && (
            <div data-slot="empty">No materials yet.</div>
          )}
          <div data-slot="empty" id="no-matches" hidden>Nothing matches that search.</div>
          {allMaterials.map(item => (
            <a
              data-component="material"
              data-type={item.data.type}
              data-search={[item.data.title, item.data.venue, item.data.abstract, ...item.data.authors, ...item.data.tags].filter(Boolean).join(' ').toLowerCase()}
              href={`${base}/${item.id}/`}
            >
              <div data-slot="material-thumb" data-type={item.data.type}>
                {item.data.thumbnail ? (
                  <img src={`${base}/${item.data.thumbnail.replace(/^\//, '')}`} alt="" />
                ) : (
                  <svg data-slot="thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={thumbIcons[item.data.type] ?? ''} />
                )}
              </div>
              <div data-slot="material-main">
                <span data-slot="material-title">
                  <span data-slot="material-date">[{formatDate(item.data.date)}]</span>
                  {item.data.title}
                </span>
                {item.data.authors.length > 0 && (
                  <span data-slot="material-venue">{item.data.authors.join(', ')}</span>
                )}
                {item.data.venue && (
                  <span data-slot="material-venue">{item.data.venue}</span>
                )}
                {item.data.abstract && (
                  <span data-slot="material-abstract">{item.data.abstract}</span>
                )}
              </div>
              <TypeBadge type={item.data.type} />
            </a>
          ))}
        </div>

      </div>
    </div>
  </main>
</Base>

<script>
  const bar = document.getElementById('filter-bar')!;
  const grid = document.getElementById('materials-grid')!;
  const btns = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-slot="filter-btn"]'));
  const DURATION = 450;

  function cleanWireClasses(el: Element) {
    el.classList.remove('wire-fill-right', 'wire-fill-left', 'wire-drain-right', 'wire-drain-left', 'wire-on', 'wire-out');
  }

  bar.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-slot="filter-btn"]');
    if (!btn || btn.classList.contains('active')) return;

    const prev = bar.querySelector('[data-slot="filter-btn"].active') as HTMLButtonElement | null;

    if (prev) {
      const prevIdx = btns.indexOf(prev);
      const nextIdx = btns.indexOf(btn);
      const goingRight = nextIdx > prevIdx;

      // Drain old button
      prev.classList.remove('active');
      cleanWireClasses(prev);
      prev.classList.add(goingRight ? 'wire-drain-right' : 'wire-drain-left');
      requestAnimationFrame(() => prev.classList.add('wire-out'));

      // Fill new button
      cleanWireClasses(btn);
      btn.classList.add(goingRight ? 'wire-fill-right' : 'wire-fill-left');
      requestAnimationFrame(() => {
        btn.classList.add('wire-on');
        btn.classList.add('active');
      });

      // Clean up after animation
      setTimeout(() => {
        cleanWireClasses(prev);
        cleanWireClasses(btn);
      }, DURATION);
    } else {
      btn.classList.add('active');
    }

    activeType = btn.dataset.type!;
    applyFilters();
  });

  // Type filter and search combine: an item shows only if it passes both
  let activeType = 'all';
  const search = document.getElementById('search') as HTMLInputElement;
  const noMatches = document.getElementById('no-matches')!;

  function applyFilters() {
    const terms = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    grid.querySelectorAll<HTMLElement>('[data-component="material"]').forEach(item => {
      const typeOk = activeType === 'all' || item.dataset.type === activeType;
      const text = item.dataset.search ?? '';
      const searchOk = terms.every(t => text.includes(t));
      item.hidden = !(typeOk && searchOk);
      if (!item.hidden) shown++;
    });
    noMatches.hidden = shown > 0;
  }

  search.addEventListener('input', applyFilters);
</script>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const allMaterials = await getCollection('materials', ({ data }) => !data.draft);

allMaterials.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL;

const types = ['all', 'talk', 'poster', 'animation'] as const;

const counts = {
  talk: allMaterials.filter(m => m.data.type === 'talk').length,
  poster: allMaterials.filter(m => m.data.type === 'poster').length,
  animation: allMaterials.filter(m => m.data.type === 'animation').length,
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' });
}
---
<Base title="My Archive — Apostolos Tsampodimos">
  <div class="lander">

    <section class="hero">
      <h1>My Archive</h1>
      <p>Talks, posters and animations.</p>
    </section>

    <section class="stats">
      <div class="stat">
        <span class="stat-number">{counts.talk}</span>
        <span class="stat-label">Talks</span>
      </div>
      <div class="stat">
        <span class="stat-number">{counts.poster}</span>
        <span class="stat-label">Posters</span>
      </div>
      <div class="stat">
        <span class="stat-number">{counts.animation}</span>
        <span class="stat-label">Animations</span>
      </div>
    </section>

    <section class="filters" id="filter-bar">
      {types.map(t => (
        <button class:list={['filter-btn', { active: t === 'all' }]} data-type={t}>
          {t === 'all' ? 'All' : t.charAt(0).toUpperCase() + t.slice(1)}
        </button>
      ))}
    </section>

    <div class="materials" id="materials-grid">
      {allMaterials.length === 0 && (
        <div class="empty">No materials yet.</div>
      )}
      {allMaterials.map(item => (
        <a class="material" data-type={item.data.type} href={`${base}${item.id}/`}>
          <div class="material-main">
            <span class="material-title">{item.data.title}</span>
            {item.data.venue && (
              <span class="material-venue">{item.data.venue}</span>
            )}
            {item.data.abstract && (
              <span class="material-abstract">{item.data.abstract}</span>
            )}
          </div>
          <div class="material-meta">
            <span class="type-badge" data-type={item.data.type}>{item.data.type}</span>
            <span class="material-date">{formatDate(item.data.date)}</span>
          </div>
        </a>
      ))}
    </div>

    <section class="footer">
      <div class="footer-col">
        <span>Apostolos Tsampodimos</span>
      </div>
    </section>

  </div>
</Base>

<script>
  const bar = document.getElementById('filter-bar')!;
  const grid = document.getElementById('materials-grid')!;

  bar.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    bar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const type = btn.dataset.type!;
    grid.querySelectorAll<HTMLElement>('.material').forEach(item => {
      item.hidden = type !== 'all' && item.dataset.type !== type;
    });
  });
</script>
